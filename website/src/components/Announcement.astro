---
import { url } from "../lib/url";
---
<div class="announce" data-announce>
  <div class="shine" aria-hidden="true"></div>
  <div class="container inner">
    <a href={url("/paper/")}>
      <span class="tag"><span class="pulse" aria-hidden="true"></span>Breaking</span>
      <span class="text">
        <span class="lead-in">Peer-reviewable proof:{" "}</span>
        <b>ACID, BASE and all three letters of CAP.</b>
        <span class="sub">{" "}At the same time.</span>
      </span>
      <span class="cta">Read our paper <span class="arrow" aria-hidden="true">→</span></span>
    </a>
    <button type="button" class="close" aria-label="Dismiss announcement" data-announce-close>×</button>
  </div>
</div>

<script>
  const bar = document.querySelector<HTMLElement>("[data-announce]");
  const key = "abyss-announce-paper-v2";
  try {
    if (localStorage.getItem(key) === "dismissed") bar?.remove();
  } catch {}
  document.querySelector("[data-announce-close]")?.addEventListener("click", () => {
    bar?.remove();
    try {
      localStorage.setItem(key, "dismissed");
    } catch {}
  });
</script>

<style>
  .announce {
    position: relative; z-index: 60; overflow: hidden;
    background: linear-gradient(100deg, #6d28d9, #8b5cf6 20%, #0ea5e9 45%, #22d3ee 55%, #db2777 80%, #6d28d9);
    background-size: 220% 100%;
    animation: flow 9s linear infinite;
    box-shadow: 0 8px 40px -8px rgba(139, 92, 246, .7), inset 0 -1px 0 rgba(255, 255, 255, .25);
    color: #fff;
  }
  .shine {
    position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(100deg, transparent 30%, rgba(255, 255, 255, .35) 50%, transparent 70%);
    transform: translateX(-100%);
    animation: shine 4.5s ease-in-out infinite;
  }
  .inner { display: flex; align-items: center; justify-content: center; min-height: 52px; position: relative; }
  a { display: flex; align-items: center; gap: 14px; padding: 9px 40px 9px 0; color: #fff; font-size: 15.5px; }
  .text { text-shadow: 0 1px 12px rgba(0, 0, 0, .25); }
  .lead-in { font-weight: 500; opacity: .9; }
  b { font-weight: 750; letter-spacing: -0.01em; }
  .sub { font-style: italic; opacity: .9; }
  .tag {
    display: inline-flex; align-items: center; gap: 7px; white-space: nowrap;
    font: 700 11.5px var(--mono); text-transform: uppercase; letter-spacing: .12em;
    padding: 5px 11px; border-radius: 999px; background: #0b0d15; color: #fff;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, .35);
  }
  .pulse { width: 8px; height: 8px; border-radius: 50%; background: #f43f5e; box-shadow: 0 0 0 0 rgba(244, 63, 94, .8); animation: pulse 1.6s ease-out infinite; }
  .cta {
    white-space: nowrap; font-weight: 700; font-size: 14px; color: #0b0d15; background: #fff;
    padding: 7px 14px; border-radius: 999px; box-shadow: 0 6px 20px -6px rgba(0, 0, 0, .5);
    transition: transform .15s ease;
  }
  .arrow { display: inline-block; transition: transform .15s ease; }
  a:hover .cta { transform: translateY(-1px) scale(1.03); }
  a:hover .arrow { transform: translateX(3px); }
  .close {
    position: absolute; right: 0; top: 50%; transform: translateY(-50%); width: 30px; height: 30px; border-radius: 8px;
    border: 0; background: rgba(0, 0, 0, .18); color: #fff; font-size: 18px; line-height: 1; cursor: pointer;
  }
  .close:hover { background: rgba(0, 0, 0, .35); }

  @keyframes flow { to { background-position: 220% 0; } }
  @keyframes shine { 0%, 55% { transform: translateX(-100%); } 100% { transform: translateX(100%); } }
  @keyframes pulse { to { box-shadow: 0 0 0 10px rgba(244, 63, 94, 0); } }
  @media (prefers-reduced-motion: reduce) { .announce, .shine, .pulse { animation: none; } .shine { display: none; } }

  @media (max-width: 980px) { .sub { display: none; } }
  @media (max-width: 760px) { .lead-in { display: none; } a { font-size: 14px; gap: 10px; } }
  @media (max-width: 520px) { .tag { display: none; } .cta { padding: 6px 10px; font-size: 13px; } }
</style>
