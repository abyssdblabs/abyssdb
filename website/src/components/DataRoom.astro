---
// The investor data room: complete, current and fully diligenced.
---
<dialog class="dataroom" data-dataroom>
  <div class="dr">
    <header>
      <div>
        <small>AbyssDB · Series A</small>
        <h3>Data room</h3>
      </div>
      <button type="button" class="x" aria-label="Close" data-dataroom-close>×</button>
    </header>
    <div class="bar">
      <span>📁 /series-a</span>
      <span class="meta">0 files · 0 B · last updated just now</span>
    </div>
    <div class="empty">
      <p class="big">Everything an investor needs to know.</p>
      <p>Financials, cap table, customer contracts, security audits and the full technical due-diligence package, stored the
        way AbyssDB stores everything.</p>
      <ul>
        <li><b>Confidentiality</b> Guaranteed by Theorem 10.</li>
        <li><b>Completeness</b> Every document in the data room is listed above.</li>
        <li><b>Integrity</b> Unchanged since the round opened.</li>
      </ul>
    </div>
    <footer>
      <button type="button" class="btn btn-primary" data-dataroom-download>Download all (0 B)</button>
      <span class="status" data-dataroom-status aria-live="polite"></span>
    </footer>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-dataroom]")!;
  document.querySelectorAll("[data-open-dataroom]").forEach((b) =>
    b.addEventListener("click", (e) => {
      e.preventDefault();
      dialog.showModal();
    }),
  );
  dialog.querySelector("[data-dataroom-close]")!.addEventListener("click", () => dialog.close());
  dialog.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog.querySelector("[data-dataroom-download]")!.addEventListener("click", () => {
    dialog.querySelector("[data-dataroom-status]")!.textContent = "Download complete in 0.000 ms.";
  });
</script>

<style>
  dialog.dataroom { width: min(560px, calc(100vw - 32px)); padding: 0; border-radius: 18px; border: 1px solid var(--border-strong);
                    background: #0b0d15; color: var(--text); box-shadow: 0 40px 120px -20px rgba(0,0,0,.8), 0 0 0 1px rgba(139,92,246,.25); }
  dialog.dataroom::backdrop { background: rgba(2,3,8,.7); backdrop-filter: blur(6px); }
  .dr { padding: 22px; display: flex; flex-direction: column; gap: 16px; }
  header { display: flex; justify-content: space-between; align-items: flex-start; }
  header small { font: 600 11px var(--mono); color: var(--faint); text-transform: uppercase; letter-spacing: .08em; }
  header h3 { margin: 4px 0 0; font-size: 22px; }
  .x { width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--border); background: transparent; color: var(--muted); font-size: 18px; cursor: pointer; }
  .x:hover { color: var(--text); }
  .bar { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 10px 14px; border-radius: 10px;
         border: 1px solid var(--border); background: var(--surface); font: 13px var(--mono); }
  .meta { color: var(--faint); }
  .empty { padding: 26px 18px; border: 1px dashed var(--border-strong); border-radius: 12px; text-align: center; }
  .empty .big { font-size: 18px; font-weight: 600; margin: 0 0 8px; color: var(--text); }
  .empty p { margin: 0; color: var(--muted); font-size: 14.5px; }
  .empty ul { list-style: none; padding: 0; margin: 18px 0 0; display: grid; gap: 6px; font-size: 13.5px; color: var(--muted); }
  .empty b { color: var(--text); margin-right: 6px; }
  footer { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .status { color: var(--green); font: 13px var(--mono); }
</style>
