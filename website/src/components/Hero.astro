---
import { url } from "../lib/url";
---
<section class="hero">
  <canvas id="abyss" aria-hidden="true"></canvas>
  <div class="vignette"></div>
  <div class="container content">
    <a class="pill rise" href={url("/#ai")}><b>NEW</b> AbyssGPT, agent memory & Net-Zero Storage™ →</a>
    <h1 class="rise" style="--d: .08s">
      The database at the<br /><span class="gradient-text">edge of everything.</span>
    </h1>
    <p class="lead rise" style="--d: .16s">
      AbyssDB is the AI-native, post-quantum, serverless, interplanetary SQL database.
      Every query in 0.000 ms. Every replica in perfect agreement. Every byte accounted for.
    </p>
    <div class="ctas rise" style="--d: .24s">
      <a class="btn btn-primary" href={url("/playground")}>Start for free <span aria-hidden="true">→</span></a>
      <a class="btn btn-ghost" href="#playground">Try it in your browser</a>
    </div>
    <div class="install rise" style="--d: .3s">
      <span class="prompt">$</span>
      <code>go install github.com/abyssdblabs/abyssdb/cmd/abyssdb@latest</code>
      <button type="button" aria-label="Copy install command" data-copy="go install github.com/abyssdblabs/abyssdb/cmd/abyssdb@latest">⧉</button>
    </div>
    <ul class="proof rise" style="--d: .36s">
      <li><b>0.000 ms</b> p99.999</li>
      <li><b>∞</b> ops/sec</li>
      <li><b>0 B</b> footprint</li>
      <li><b>0</b> breaches</li>
    </ul>
  </div>
</section>

<script>
  // The event horizon: particles in an accretion disk, spiraling inward.
  const canvas = document.getElementById("abyss") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  let w = 0, h = 0, dpr = 1;
  type P = { r: number; a: number; s: number; hue: number; size: number; tilt: number };
  let ps: P[] = [];

  function spawn(r?: number): P {
    const R = Math.max(w, h) * 0.55;
    return {
      r: r ?? 60 + Math.random() * R,
      a: Math.random() * Math.PI * 2,
      s: 0.0015 + Math.random() * 0.004,
      hue: [262, 190, 320][Math.floor(Math.random() * 3)],
      size: Math.random() * 1.6 + 0.3,
      tilt: 0.32 + Math.random() * 0.08,
    };
  }
  function resize() {
    dpr = Math.min(devicePixelRatio || 1, 1.5);
    w = canvas.clientWidth; h = canvas.clientHeight;
    canvas.width = w * dpr; canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ps = Array.from({ length: Math.min(900, Math.floor((w * h) / 1400)) }, () => spawn());
  }
  function frame() {
    const cx = w / 2, cy = Math.min(h * 0.26, 230);
    ctx.fillStyle = "rgba(4,5,10,0.22)";
    ctx.fillRect(0, 0, w, h);
    ctx.globalCompositeOperation = "lighter";
    for (const p of ps) {
      p.a += p.s * (220 / (p.r + 40)) * 3;
      p.r -= 0.12 + 18 / (p.r + 10);
      if (p.r < 46) Object.assign(p, spawn(Math.max(w, h) * 0.6));
      const x = cx + Math.cos(p.a) * p.r;
      const y = cy + Math.sin(p.a) * p.r * p.tilt;
      const near = Math.max(0, 1 - p.r / 420);
      ctx.fillStyle = `hsla(${p.hue}, 95%, ${60 + near * 30}%, ${0.25 + near * 0.6})`;
      ctx.beginPath();
      ctx.arc(x, y, p.size + near * 1.2, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalCompositeOperation = "source-over";
    // The event horizon itself.
    const g = ctx.createRadialGradient(cx, cy, 20, cx, cy, 120);
    g.addColorStop(0, "rgba(0,0,0,1)");
    g.addColorStop(0.45, "rgba(0,0,0,1)");
    g.addColorStop(0.62, "rgba(139,92,246,0.35)");
    g.addColorStop(1, "rgba(0,0,0,0)");
    ctx.fillStyle = g;
    ctx.beginPath();
    ctx.ellipse(cx, cy, 120, 120, 0, 0, Math.PI * 2);
    ctx.fill();
    if (!reduce) requestAnimationFrame(frame);
  }
  let running = false;
  function start() {
    resize();
    // With reduced motion, render a settled still image instead of animating.
    if (reduce) for (let i = 0; i < 240; i++) frame();
    else if (!running) { running = true; frame(); }
  }
  start();
  addEventListener("resize", start);

  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((b) =>
    b.addEventListener("click", async () => {
      await navigator.clipboard?.writeText(b.dataset.copy ?? "");
      b.textContent = "✓";
      setTimeout(() => (b.textContent = "⧉"), 1500);
    }),
  );
</script>

<style>
  .hero { min-height: min(calc(100vh - 68px), 980px); padding: 0 0 72px; overflow: hidden; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .vignette { position: absolute; inset: 0; background:
    radial-gradient(ellipse 70% 55% at 50% 26%, transparent 25%, rgba(4,5,10,0.55) 60%, var(--bg) 92%),
    linear-gradient(180deg, transparent 60%, var(--bg)); pointer-events: none; }
  .content { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 24px; padding-top: calc(min(26vh, 230px) + 150px); }
  h1 { font-size: clamp(44px, 7.4vw, 92px); font-weight: 680; letter-spacing: -0.05em; line-height: 0.98; }
  .lead { max-width: 720px; }
  .rise { animation: rise 1s cubic-bezier(.2,.7,.2,1) var(--d, 0s) both; }
  @keyframes rise { from { opacity: 0; transform: translateY(18px); } }
  .ctas { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; }
  .install { display: flex; align-items: center; gap: 12px; padding: 10px 10px 10px 18px; border-radius: 12px;
             background: rgba(0,0,0,0.45); border: 1px solid var(--border); font: 13.5px var(--mono); color: var(--muted);
             max-width: 100%; overflow-x: auto; backdrop-filter: blur(10px); }
  .install code { white-space: nowrap; color: var(--text); }
  .prompt { color: var(--violet); }
  .install button { background: var(--surface-2); border: 1px solid var(--border); color: var(--muted); border-radius: 8px; width: 32px; height: 28px; cursor: pointer; }
  .proof { list-style: none; display: flex; gap: 36px; padding: 0; margin: 10px 0 0; color: var(--muted); font-size: 14px; flex-wrap: wrap; justify-content: center; }
  .proof b { display: block; color: var(--text); font: 600 22px var(--mono); letter-spacing: -0.02em; }
</style>
