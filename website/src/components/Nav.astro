---
import { url } from "../lib/url";
import Logo from "./Logo.astro";
const links = [
  ["Product", "/#product"],
  ["AI", "/#ai"],
  ["Benchmarks", "/#benchmarks"],
  ["Pricing", "/#pricing"],
  ["Playground", "/playground"],
  ["Docs", "/docs/"],
  ["Investors", "/investors/"],
];
---
<header class="nav">
  <div class="container inner">
    <a href={url("/")} class="brand"><Logo /> <span>AbyssDB</span></a>
    <nav>
      {links.map(([label, href]) => <a href={url(href)}>{label}</a>)}
    </nav>
    <div class="actions">
      <a class="stars" href="https://github.com/noctarius/abyssdb" aria-label="GitHub">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        <span>★ ∞</span>
      </a>
      <a class="btn btn-primary small" href={url("/playground")}>Start for free</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    backdrop-filter: blur(16px) saturate(140%);
    background: rgba(4, 5, 10, 0.6);
    border-bottom: 1px solid var(--border);
  }
  .inner { display: flex; align-items: center; justify-content: space-between; height: 68px; gap: 24px; }
  .brand { display: flex; align-items: center; gap: 10px; font-weight: 650; font-size: 18px; letter-spacing: -0.02em; }
  nav { display: flex; gap: 28px; font-size: 14.5px; color: var(--muted); }
  nav a:hover { color: var(--text); }
  .actions { display: flex; align-items: center; gap: 12px; }
  .stars { display: flex; align-items: center; gap: 8px; font: 500 13px var(--mono); color: var(--muted);
           padding: 8px 12px; border: 1px solid var(--border); border-radius: 999px; }
  .stars:hover { color: var(--text); }
  .small { height: 38px; padding: 0 16px; font-size: 14px; }
  @media (max-width: 900px) { nav { display: none; } }
  @media (max-width: 480px) { .stars { display: none; } }
</style>
