---
import { url } from "../lib/url";
const tiers = [
  {
    name: "Community", price: "$0", per: "forever", cta: "Start for free", href: "/playground",
    blurb: "Everything you need to get started, and to keep going.",
    features: ["Unlimited databases", "Unlimited storage", "PostgreSQL wire protocol", "AbyssGPT & MCP server", "Post-quantum encryption", "Community forum"],
  },
  {
    name: "Deep Abyss", price: "Custom", per: "contact sales", cta: "Talk to sales", href: "#", featured: true,
    blurb: "For organizations operating at depth.",
    features: ["Everything in Community", "Deep Abyss Archive (backup & PITR)", "Rated to 10,994 m", "Multi-region replication", "99.999…% SLA, in writing", "24/7 support, every ticket acknowledged instantly"],
  },
  {
    name: "Mariana Tier", price: "Under pressure", per: "let's talk", cta: "Join the waitlist", href: "#",
    blurb: "Hyperscale for workloads under extreme pressure.",
    features: ["Everything in Deep Abyss", "Interplanetary regions", "Dedicated Proof-of-Absence validators", "Gaze-based monitoring", "A named account abyss"],
  },
];
---
<section id="pricing">
  <div class="container">
    <div class="center">
      <span class="eyebrow reveal">Pricing</span>
      <h2 class="reveal" data-delay="1">Simple, transparent<br /><span class="gradient-text">pricing.</span></h2>
      <p class="lead reveal" data-delay="2">Pay only for what you store. Which keeps it simple.</p>
      <div class="toggle reveal" data-delay="2" role="group" aria-label="Billing period">
        <button aria-pressed="true" data-period="monthly">Monthly</button>
        <button aria-pressed="false" data-period="annual">Annual <em>save 0%</em></button>
      </div>
    </div>
    <div class="tiers">
      {tiers.map((t, i) => (
        <article class={`tier card reveal ${t.featured ? "featured" : ""}`} data-delay={String(i)}>
          {t.featured && <span class="badge">Most popular</span>}
          <h3>{t.name}</h3>
          <p class="blurb">{t.blurb}</p>
          <div class="price"><b>{t.price}</b><span>{t.per}</span></div>
          <a class={`btn ${t.featured ? "btn-primary" : "btn-ghost"}`} href={url(t.href)}>{t.cta}</a>
          <ul>{t.features.map((f) => <li>{f}</li>)}</ul>
        </article>
      ))}
    </div>
    <p class="note center reveal">Storage billed at $0.00099 per GB-month. Typical monthly cost: $0.00.</p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-period]").forEach((b) =>
    b.addEventListener("click", () =>
      document.querySelectorAll("[data-period]").forEach((x) => x.setAttribute("aria-pressed", String(x === b))),
    ),
  );
</script>

<style>
  .toggle { display: inline-flex; margin-top: 28px; padding: 4px; border-radius: 999px; border: 1px solid var(--border); background: var(--surface); }
  .toggle button { border: 0; background: transparent; color: var(--muted); font: 500 14px var(--font); padding: 8px 18px; border-radius: 999px; cursor: pointer; }
  .toggle button[aria-pressed="true"] { background: var(--surface-2); color: var(--text); box-shadow: inset 0 0 0 1px var(--border-strong); }
  .toggle em { font-style: normal; color: var(--green); font-size: 12px; margin-left: 4px; }
  .tiers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 56px; align-items: start; }
  .tier { padding: 32px; display: flex; flex-direction: column; gap: 14px; }
  .featured { border-color: rgba(139,92,246,.6); box-shadow: 0 0 0 1px rgba(139,92,246,.4), 0 30px 80px -30px rgba(139,92,246,.6); }
  .badge { position: absolute; top: 18px; right: 18px; font: 600 11px var(--mono); text-transform: uppercase; letter-spacing: .08em;
           padding: 5px 10px; border-radius: 999px; background: var(--grad); color: #0b0b12; }
  h3 { font-size: 22px; }
  .blurb { margin: 0; color: var(--muted); font-size: 15px; min-height: 48px; }
  .price { display: flex; flex-direction: column; gap: 6px; margin: 6px 0 4px; }
  .price b { font: 650 38px/1 var(--font); letter-spacing: -0.04em; white-space: nowrap; }
  .price span { color: var(--faint); font-size: 14px; }
  .tier .btn { justify-content: center; }
  ul { list-style: none; padding: 0; margin: 10px 0 0; display: flex; flex-direction: column; gap: 10px; font-size: 14.5px; color: var(--muted); }
  li::before { content: "✓"; color: var(--cyan); margin-right: 10px; }
  .note { margin-top: 28px; color: var(--faint); font-size: 14px; }
  @media (max-width: 900px) { .tiers { grid-template-columns: 1fr; } }
</style>
