---
import Base from "./Base.astro";
import { url } from "../lib/url";
import { grouped, ordered, repo, slugOf, sourceFile, titleOf, type Doc } from "../lib/docs";

interface Props {
  doc: Doc;
  all: Doc[];
  headings: { depth: number; slug: string; text: string }[];
}
const { doc, all, headings } = Astro.props;

const href = (d: Doc) => url(slugOf(d) ? `/docs/${slugOf(d)}/` : "/docs/");
const title = titleOf(doc);
const groups = grouped(all);
const flat = ordered(all);
const i = flat.findIndex((d) => d.id === doc.id);
const prev = i > 0 ? flat[i - 1] : undefined;
const next = i < flat.length - 1 ? flat[i + 1] : undefined;
const section = groups.find((g) => g.docs.some((d) => d.id === doc.id))?.title ?? "Docs";
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
<Base title={`${title} · AbyssDB Docs`} description={`AbyssDB documentation: ${title}.`} image="/og/docs.png" imageAlt="AbyssDB documentation: zero learning curve, zero-knowledge.">
  <div class="docs container">
    <aside class="sidebar">
      <button class="search-btn" type="button" data-open-search>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <span>Search docs</span>
        <kbd>⌘K</kbd>
      </button>
      <details class="menu" open>
        <summary>Documentation</summary>
        <nav aria-label="Documentation">
          {groups.map((g) => (
            <div class="group">
              <h4>{g.title}</h4>
              {g.docs.map((d) => (
                <a href={href(d)} aria-current={d.id === doc.id ? "page" : undefined}>{d.id === "readme" ? "Overview" : titleOf(d)}</a>
              ))}
            </div>
          ))}
        </nav>
      </details>
    </aside>

    <article class="prose" data-pagefind-body>
      <div class="crumbs" data-pagefind-ignore><a href={url("/docs/")}>Docs</a><span>/</span><span>{section}</span></div>
      <slot />
      <footer class="doc-foot" data-pagefind-ignore>
        <a class="edit" href={`${repo}/edit/main/docs/${sourceFile(doc)}`}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
          Edit this page on GitHub
        </a>
        <div class="pager">
          {prev ? <a class="card prev" href={href(prev)}><small>Previous</small><b>← {prev.id === "readme" ? "Overview" : titleOf(prev)}</b></a> : <span />}
          {next && <a class="card next" href={href(next)}><small>Next</small><b>{titleOf(next)} →</b></a>}
        </div>
      </footer>
    </article>

    <nav class="toc" aria-label="On this page">
      {toc.length > 0 && (
        <>
          <h4>On this page</h4>
          {toc.map((h) => <a href={`#${h.slug}`} class={`d${h.depth}`} data-toc={h.slug}>{h.text}</a>)}
        </>
      )}
    </nav>
  </div>

  <dialog class="search" data-search-dialog data-base={url("/")} data-bundle={url("/pagefind/")}>
    <div class="search-box">
      <div data-search-ui></div>
      <p class="search-hint" data-search-hint hidden>Search is available in production builds (<code>npm run build</code>).</p>
    </div>
  </dialog>
</Base>

<script>
  // Highlight the section currently in view.
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>("[data-toc]").forEach((a) => links.set(a.dataset.toc!, a));
  const visible = new Set<string>();
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id);
    const first = [...links.keys()].find((id) => visible.has(id));
    if (first) links.forEach((a, id) => a.classList.toggle("active", id === first));
  }, { rootMargin: "-80px 0px -60% 0px" });
  links.forEach((_, id) => { const el = document.getElementById(id); if (el) io.observe(el); });

  // Collapse the sidebar menu on small screens.
  const menu = document.querySelector<HTMLDetailsElement>(".menu");
  if (menu && matchMedia("(max-width: 900px)").matches) menu.open = false;

  // Search (Pagefind), opened with ⌘K / Ctrl+K or the sidebar button.
  const dialog = document.querySelector<HTMLDialogElement>("[data-search-dialog]")!;
  let loaded = false;
  async function openSearch() {
    dialog.showModal();
    if (loaded) { dialog.querySelector<HTMLInputElement>("input")?.focus(); return; }
    loaded = true;
    const bundle = dialog.dataset.bundle!;
    try {
      const css = document.createElement("link");
      css.rel = "stylesheet";
      css.href = bundle + "pagefind-ui.css";
      document.head.append(css);
      await new Promise<void>((resolve, reject) => {
        const s = document.createElement("script");
        s.src = bundle + "pagefind-ui.js";
        s.onload = () => resolve();
        s.onerror = () => reject();
        document.head.append(s);
      });
      // @ts-expect-error provided by pagefind-ui.js
      new PagefindUI({ element: "[data-search-ui]", showSubResults: true, showImages: false, baseUrl: dialog.dataset.base, autofocus: true });
    } catch {
      dialog.querySelector<HTMLElement>("[data-search-hint]")!.hidden = false;
    }
  }
  document.querySelectorAll("[data-open-search]").forEach((b) => b.addEventListener("click", openSearch));
  addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") { e.preventDefault(); openSearch(); }
  });
  dialog.addEventListener("click", (e) => { if (e.target === dialog) dialog.close(); });
</script>

<style>
  .docs { display: grid; grid-template-columns: 240px minmax(0, 1fr) 210px; gap: 56px; padding-top: 40px; padding-bottom: 96px; align-items: start; }
  .sidebar, .toc { position: sticky; top: 92px; max-height: calc(100vh - 110px); overflow-y: auto; }

  .search-btn { width: 100%; display: flex; align-items: center; gap: 10px; padding: 9px 12px; margin-bottom: 22px; border-radius: 10px;
                border: 1px solid var(--border); background: var(--surface); color: var(--muted); font: 14px var(--font); cursor: pointer; }
  .search-btn:hover { border-color: var(--border-strong); color: var(--text); }
  .search-btn kbd { margin-left: auto; font: 11.5px var(--mono); padding: 2px 6px; border-radius: 5px; border: 1px solid var(--border); }

  .menu summary { display: none; }
  .group { margin-bottom: 22px; }
  .group h4 { margin: 0 0 8px; font: 600 12px var(--mono); text-transform: uppercase; letter-spacing: .08em; color: var(--faint); }
  .group a { display: block; padding: 6px 12px; margin-left: -12px; border-radius: 8px; color: var(--muted); font-size: 14.5px; }
  .group a:hover { color: var(--text); background: var(--surface); }
  .group a[aria-current="page"] { color: var(--text); background: linear-gradient(90deg, rgba(139,92,246,.18), rgba(139,92,246,.03)); box-shadow: inset 2px 0 0 var(--violet); }

  .toc h4 { margin: 0 0 10px; font: 600 12px var(--mono); text-transform: uppercase; letter-spacing: .08em; color: var(--faint); }
  .toc a { display: block; padding: 4px 0 4px 12px; border-left: 1px solid var(--border); color: var(--faint); font-size: 13.5px; line-height: 1.4; }
  .toc a.d3 { padding-left: 24px; }
  .toc a:hover { color: var(--text); }
  .toc a.active { color: var(--text); border-left-color: var(--cyan); }

  .crumbs { display: flex; gap: 8px; font: 13px var(--mono); color: var(--faint); margin-bottom: 18px; }
  .crumbs a:hover { color: var(--text); }

  .doc-foot { margin-top: 64px; padding-top: 24px; border-top: 1px solid var(--border); }
  .edit { display: inline-flex; align-items: center; gap: 8px; color: var(--muted); font-size: 14px; }
  .edit:hover { color: var(--text); }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 28px; }
  .pager .card { padding: 18px 20px; display: flex; flex-direction: column; gap: 4px; }
  .pager small { color: var(--faint); font-size: 12.5px; }
  .pager b { font-weight: 600; }
  .pager .next { grid-column: 2; text-align: right; }

  dialog.search { width: min(680px, calc(100vw - 32px)); max-height: 75vh; margin-top: 12vh; padding: 0; border: 1px solid var(--border-strong);
                  border-radius: 16px; background: #0b0d15; color: var(--text); box-shadow: 0 40px 120px -20px rgba(0,0,0,.8), 0 0 0 1px rgba(139,92,246,.2); }
  dialog.search::backdrop { background: rgba(2,3,8,.7); backdrop-filter: blur(6px); }
  .search-box { padding: 18px; }
  .search-hint { color: var(--muted); margin: 6px 0; }
  .search-box :global(.pagefind-ui) {
    --pagefind-ui-scale: .85; --pagefind-ui-primary: #a78bfa; --pagefind-ui-text: #eef0f7; --pagefind-ui-background: #0b0d15;
    --pagefind-ui-border: rgba(255,255,255,.12); --pagefind-ui-tag: rgba(255,255,255,.06); --pagefind-ui-border-radius: 10px;
    --pagefind-ui-font: var(--font);
  }
  .search-box :global(.pagefind-ui__result-excerpt), .search-box :global(.pagefind-ui__message) { color: var(--muted); }
  .search-box :global(mark) { background: rgba(139,92,246,.35); color: var(--text); border-radius: 3px; }

  @media (max-width: 1180px) { .docs { grid-template-columns: 230px minmax(0, 1fr); } .toc { display: none; } }
  @media (max-width: 900px) {
    .docs { grid-template-columns: minmax(0, 1fr); gap: 24px; padding-top: 24px; }
    .sidebar { position: static; max-height: none; }
    .menu { border: 1px solid var(--border); border-radius: 12px; padding: 12px 16px; }
    .menu summary { display: block; cursor: pointer; font-weight: 600; }
    .menu[open] summary { margin-bottom: 16px; }
    .pager { grid-template-columns: 1fr; } .pager .next { grid-column: auto; }
  }
</style>
